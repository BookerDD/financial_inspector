# Скопировать в .env и подставить свои значения:
#   cp .env.example .env

# --- Compose ---
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yaml:docker-compose.airflow.yaml:docker-compose.superset.yaml

# --- Порты на хосте ---
# Поменять, если заняты (например, локальным Postgres или другим проектом).
POSTGRES_HOST_PORT=5432
AIRFLOW_HOST_PORT=8080
SUPERSET_HOST_PORT=8088

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
AIRFLOW_DB_PASSWORD=airflow
SUPERSET_DB_PASSWORD=superset
ANALYTICS_DB_PASSWORD=analytics

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=change-me

# --- Superset ---
SUPERSET_SECRET_KEY=change-me
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
